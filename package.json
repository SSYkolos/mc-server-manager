{
  "name": "mc-server-manager",
  "version": "1.1.2",
  "description": "Minecraft server manager desktop app",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "ISC",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"npm run electron:dev\"",
    "react-start": "react-scripts start",
    "build:react": "react-scripts build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run build:react && npm run build:electron",
    "electron:dev": "cross-env NODE_ENV=development npm run build:electron && wait-on tcp:3000 && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "extends": null,
    "asar": true,
    "asarUnpack": [
      "dist-electron/preload.js"
    ],
    "extraResources": [
      {
        "from": "google-oauth.json",
        "to": "google-oauth.json"
      }
    ],
    "compression": "maximum",
    "appId": "com.kolos.mcservermanager",
    "productName": "MC Server Manager",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "build/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.4",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "archiver": "^7.0.1",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "firebase": "^11.10.0",
    "googleapis": "^124.0.0",
    "got": "^11.8.6",
    "ini": "^5.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.516.0",
    "nat-upnp": "^1.1.1",
    "node-fetch": "^2.7.0",
    "open": "^11.0.0",
    "path-browserify": "^1.0.1",
    "pidusage": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "react-scripts": "^5.0.1",
    "simple-peer": "^9.11.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/got": "^9.6.12",
    "@types/ini": "^4.1.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/nat-upnp": "^1.1.5",
    "@types/node": "^18.19.130",
    "@types/node-fetch": "^2.6.12",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/simple-peer": "^9.11.9",
    "@types/unzipper": "^0.10.11",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "tsx": "^4.20.3",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
